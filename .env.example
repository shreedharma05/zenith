OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ZENITH_MODEL=llama3.2:3b
OLLAMA_KEEP_ALIVE=30m

# --- Web backend (auth + API) -------------------------------------------
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=
# Defaults to a local SQLite file; set to a Postgres URL for production.
DATABASE_URL=sqlite:////app/.cache/zenith.db
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
# Resend SMTP relay: https://resend.com -> API Keys -> Create API Key.
# onboarding@resend.dev works immediately but only delivers to the email you
# signed up to Resend with -- verify your own domain (Domains -> Add Domain)
# before onboarding real users.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
# The API key itself (starts with re_), NOT your Resend account password.
SMTP_PASSWORD=
SMTP_FROM=onboarding@resend.dev

# Local startup: bash start.sh, then choose 1.
# OpenAI startup: set the key above in .env, run bash start.sh, choose 2.
# Apple Silicon native Ollama: ZENITH_OLLAMA_RUNTIME=host bash start.sh
# Then choose 1; install/run Ollama on macOS and pull ZENITH_MODEL first.